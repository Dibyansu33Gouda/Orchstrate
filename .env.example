# LLM Provider Configuration (Optional - falls back to deterministic-only mode if unset)
# Set at least one provider key if LLM adjudication is desired:
GEMINI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# LLM Model Name override (defaults to gemini-2.5-flash or llama-3.3-70b-versatile or gpt-4o)
AUDIT_LLM_PROVIDER=gemini
AUDIT_LLM_MODEL=gemini-2.5-flash

# Execution Mode: 'hybrid' (LLM + gate) or 'deterministic' (gate only)
AUDIT_MODE=hybrid

# Hard cap on agent tool-calling iterations per request (default: 12)
AUDIT_MAX_ITERATIONS=12
